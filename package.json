{
  "name": "sam-personal-workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "test:extensions": "node --import ./extensions/subagents/test-loader.mjs --test extensions/bash-guard/test.mjs extensions/lean-context/test.mjs extensions/session-handoff/test.mjs extensions/subagents/test.mjs",
    "test:contract": "python3 .agents/skills/devops-pi-agent-maintenance/scripts/validate_repo_contract.py",
    "benchmark:invocation": "python3 .agents/skills/devops-pi-agent-maintenance/scripts/run_invocation_benchmark.py"
  },
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./extensions/bash-guard",
      "./extensions/lean-context",
      "./extensions/session-handoff",
      "./extensions/web-fetch",
      "./extensions/web-search",
      "./extensions/subagents"
    ],
    "skills": ["./.agents/skills"]
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.16.0",
    "turndown": "^7.2.0",
    "unpdf": "^1.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
